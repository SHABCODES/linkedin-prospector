# ──────────────────────────────────────────────────────────────
# LinkedIn Prospector — Environment Variables
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# SQLite (dev, no setup required — default)
DATABASE_URL=sqlite+aiosqlite:///./linkedin_prospector.db

# PostgreSQL (prod — uncomment and fill)
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/linkedin_prospector

# ── B2B Data ──────────────────────────────────────────────────
# Apollo.io API key — https://apollo.io
# Leave blank to use MOCK MODE (no cost, uses fixture data)
APOLLO_API_KEY=

# ── AI / LLM ──────────────────────────────────────────────────
# Google Gemini API key — https://aistudio.google.com/app/apikey
# Leave blank to use rule-based fallback (no LLM calls)
GEMINI_API_KEY=

# Gemini model to use
GEMINI_MODEL=gemini-1.5-flash

# ── App Settings ──────────────────────────────────────────────
APP_ENV=development          # development | production
LOG_LEVEL=INFO

# ── Project 1 Integration (optional) ─────────────────────────
# If set, exporter.py can push prospects directly into the
# ai-outreach-engine Postgres DB
# OUTREACH_ENGINE_DB_URL=postgresql+psycopg2://user:password@localhost:5432/outreach_engine
OUTREACH_ENGINE_DB_URL=
